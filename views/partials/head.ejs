<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || 'Pastelaria Luar de Prata · Pontinha' %></title>
  <% if (description) { %><meta name="description" content="<%= description %>"><% } %>
  <meta name="theme-color" content="#14172b">
  <meta property="og:title" content="<%= title || 'Pastelaria Luar de Prata' %>">
  <% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
  <meta property="og:type" content="website">
  <meta property="og:image" content="/img/logo.png">
  <link rel="icon" href="/img/favicon.ico">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=1">
  <script>
    (function () {
      var h = document.documentElement;
      h.classList.add('js');
      try { if (!sessionStorage.getItem('lp-intro')) h.classList.add('show-intro'); } catch (e) {}
    })();
  </script>
</head>
<body>
<div id="curtain" aria-hidden="true"><img src="/img/logo-96.png" alt="" width="72" height="72"></div>
<div id="intro" aria-hidden="true">
  <div class="intro-moon"></div>
  <img src="/img/logo.png" alt="" width="160" height="160">
  <p>Pastelaria Arte e Sabor</p>
</div>
<a class="skip" href="#main">Saltar para o conteúdo</a>
<%- include('header') %>
<main id="main">
