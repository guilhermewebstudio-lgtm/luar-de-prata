<%- include('_head', { tab: '' }) %>
<main class="login">
  <form class="card login-card" method="post" action="/admin/login">
    <img src="/img/logo-96.png" alt="" width="72" height="72">
    <h1>Área reservada</h1>
    <p class="muted">Entre para gerir a ementa, as fotos e as encomendas.</p>
    <% if (error) { %><div class="alert"><%= error %></div><% } %>
    <label>Email<input type="email" name="email" required autocomplete="username" autofocus></label>
    <label>Palavra-passe<input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn" type="submit">Entrar</button>
    <a class="back" href="/">← Voltar ao site</a>
  </form>
</main>
</body></html>
